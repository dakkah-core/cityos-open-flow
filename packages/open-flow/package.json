  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "bun run format -- --check && bun run lint && bun run check:trigger-locales && bun run check:types && bun run check:boundaries",
    "check:boundaries": "bun scripts/check-platform-boundaries.ts && bun scripts/check-catalog-boundaries.ts",
    "check:types": "tsc --noEmit",
    "designer:build": "vite build --config dev/designer/vite.config.ts",
    "designer:deploy": "bun run designer:build && wrangler deploy --config dev/designer/wrangler.jsonc",
    "designer:dev": "vite --config dev/designer/vite.config.ts",
    "format": "oxfmt README.md NOTICE skills src test scripts dev vitest.config.ts package.json tsconfig.json",
    "lint": "oxlint --deny-warnings src test scripts dev vitest.config.ts",
    "test": "bun run test:vitest",
    "test:coverage": "bun run test --coverage",
    "test:vitest": "vitest run --config vitest.config.ts src test dev",
    "test:package": "bun scripts/check-npm-package.ts",
    "generate:trigger-locales": "bun scripts/trigger-locales.ts",
    "check:trigger-locales": "bun scripts/trigger-locales.ts --check",
    "generate:provider-triggers": "bun scripts/update-trigger-catalog.ts",
    "skill:generate": "bun scripts/generate-skill.ts"
  },
  "type": "module",
  "version": "0.1.0-beta.69"
