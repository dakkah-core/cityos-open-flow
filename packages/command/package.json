{
  "name": "@oomol-lab/open-flow-command",
  "version": "0.1.0-beta.65",
  "description": "Open Flow command runtime and npm entry builder.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "bun run format -- --check && bun run lint && tsc --noEmit",
    "format": "oxfmt src test scripts vitest.config.ts package.json tsconfig.json",
    "lint": "oxlint --deny-warnings src test scripts vitest.config.ts",
    "test": "vitest run --config vitest.config.ts src test"
  },
  "dependencies": {
    "@oomol-lab/open-flow": "workspace:*",
    "@wopjs/cast": "catalog:",
    "val-i18n": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "exports": {
    ".": "./src/cli/node/command.ts",
    "./lab": "./src/cli/node/lab.ts",
    "./development": "./src/cli/node/runtime.ts",
    "./package.json": "./package.json"
  }
}
